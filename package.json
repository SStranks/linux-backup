{
  "name": "linux-backup",
  "version": "1.0.0",
  "description": "WSL2 Backup Automation",
  "author": "Simon Stranks <sstranks0@gmail.com> <https://github.com/SStranks>",
  "repository": {
    "type": "github",
    "url": "https://github.com/SStranks/linux-backup"
  },
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^22.18.0",
    "pnpm": "^=12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": "^22.18.0"
    }
  },
  "scripts": {
    "megalint": "docker run --rm -e MEGALINTER_CONFIG=.mega-linter.local.yaml -v \"$(pwd)\":/tmp/lint oxsecurity/megalinter:v8",
    "prepare": "husky"
  },
  "prettier": "@packages/prettier-config",
  "dependencies": {
    "@packages/commitlint-config": "workspace:*",
    "@packages/prettier-config": "workspace:*",
    "@packages/secretlint-config": "workspace:*"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "secretlint": "^13.1.0"
  }
}
